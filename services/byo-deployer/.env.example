# Required: Supabase project URL and service-role key (used for both REST + LISTEN)
SUPABASE_URL=https://xxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Required: direct Postgres connection string for LISTEN/NOTIFY
# Use the "session" connection (port 5432), NOT the pooler — pgbouncer breaks LISTEN.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxx.supabase.co:5432/postgres

# Required: must match the SMTP_ENCRYPTION_KEY in Supabase edge functions
# (64-char hex, 32 bytes). Used to decrypt byo_servers.ssh_private_key_encrypted.
# Generate one with: openssl rand -hex 32
SMTP_ENCRYPTION_KEY=

# Required: HMAC secret shared with edge functions for /jobs/run-now wake-ups
# (set BYO_DEPLOYER_TRIGGER_SECRET to the same value in Supabase function secrets)
DEPLOYER_TRIGGER_SECRET=replace-me-with-a-32-byte-random-hex

# Optional: bind address / port (Fly sets PORT automatically)
PORT=8080

# Optional: log verbosity
LOG_LEVEL=info
