# Set on the web-capture app (Fly secrets, Docker env).


# Also reads (set above): OPENROUTER_API_KEY

# Set by the platform, don't set these yourself: PORT (the host)

##############################################################################
# Worker: services/byo-deployer
##############################################################################
# Set on the byo-deployer app (Fly secrets, Docker env).

# Used in services/byo-deployer/src/server.ts
DEPLOYER_NAME=
# Used in services/byo-deployer/src/server.ts
DEPLOYER_TRIGGER_SECRET=
# Used in services/byo-deployer/src/job-runner.ts
LOG_LEVEL=
# Used in services/byo-deployer/src/job-runner.ts
SUPABASE_DB_URL=

# Also reads (set above): SMTP_ENCRYPTION_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_URL

# Set by the platform, don't set these yourself: PORT (the host)
