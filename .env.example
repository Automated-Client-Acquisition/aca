# ACA environment variables. Generated by scripts/oss/build-env-example.py;
# rerun it after adding a variable. Copy to .env and fill in what you use.
#
# Every third-party key is optional unless marked REQUIRED: a missing key
# switches its feature off. Defaults in src/config/site.ts and
# supabase/functions/_shared/site-config.ts are ACA Cloud's addresses;
# a self-hosted install should set its own.

##############################################################################
# Frontend (read by Vite at build time)
##############################################################################
# Set in .env before `npm run build`, or in your host's build settings.

# REQUIRED. Your Supabase anon (publishable) key
#   used in src/hooks/useEditorChat.ts (+3 more)
VITE_SUPABASE_PUBLISHABLE_KEY=
# REQUIRED. Your Supabase project URL, e.g. https://xyz.supabase.co
#   used in src/components/AddIdeaDialog.tsx (+29 more)
VITE_SUPABASE_URL=
# Public storage with starter images and sound effects (defaults to ACA Cloud's)
#   used in src/config/site.ts
VITE_ACA_ASSETS_URL=
# Used in src/config/site.ts
VITE_ACA_SELF_HOSTED=
