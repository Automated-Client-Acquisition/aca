# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Encryption keys (same as Supabase edge function secrets)
SMTP_ENCRYPTION_KEY=64-char-hex-string
ENCRYPTION_KEY=64-char-hex-string

# Worker config
POLL_CONCURRENCY=10
POLL_INTERVAL_MS=5000
MAILBOX_TIMEOUT_MS=45000
PORT=8080
